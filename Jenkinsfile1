pipeline {
    agent any

    environment {
        IMAGE_NAME = "rootpromptnext/java-springboot-app"
        DOCKER_USER = "rootpromptnext"
        DOCKER_PASS = "removed"
    }

    stages {

        stage('Clone Repo') {
            steps {
                sh '''
                rm -rf java-springboot-app
                git clone https://github.com/rootpromptnext/java-springboot-app.git
                '''
            }
        }

        stage('Create Short Commit SHA') {
            steps {
                sh '''
                cd java-springboot-app
                git rev-parse --short HEAD > short_sha.txt
                '''
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                sh '''
                cd java-springboot-app
                SHORT_SHA=$(cat short_sha.txt)

                docker login -u $DOCKER_USER -p $DOCKER_PASS

                docker build -t java-springboot-app:$SHORT_SHA .
                docker tag java-springboot-app:$SHORT_SHA $IMAGE_NAME:$SHORT_SHA
                docker tag java-springboot-app:$SHORT_SHA $IMAGE_NAME:latest

                docker push $IMAGE_NAME:$SHORT_SHA
                docker push $IMAGE_NAME:latest
                '''
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                cd java-springboot-app
                kubectl apply -f deployment.yaml
                '''
            }
        }
    }
}
